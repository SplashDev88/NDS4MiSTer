# This repo's documentation IS markdown, and a global core.excludesFile with a
# blanket *.md silently hid new docs from `git status` - one ticket sat
# uncommitted for 12 days that way. A repo .gitignore outranks the
# global one, so this puts them back in view. Files under an ignored DIRECTORY
# (sim/nvc_work/, .claude/worktrees/) stay ignored: git does not descend into it.
!*.md

sim/nvc_work/
*.o
*.rbf
*.sof
output_files/
db/
incremental_db/
c5_pin_model_dump.txt
build_id.v
*.qws
.DS_Store

# generated test workloads (deterministic from gen_arm9_torture.py)
sim/tests/arm9_torture.s
sim/tests/arm9_torture.bin
sim/tests/arm9_torture.hex
sim/tests/arm7_island.bin
sim/tests/arm9_island.bin
sim/melonds_tracer/build/
arm9_trace.log

# generated GPU golden vectors (deterministic from gen_gpu_bg.py / gen_gpu_obj.py)
sim/tests/gpu_bg_*.hex
sim/tests/gpu_obj_*.hex
sim/tests/vram_ls_vectors.hex

# generated gpu2d vectors (deterministic from gen_gpu2d.py / gen_gpu2d_frame.py)
sim/tests/gpu2d_*.hex
sim/tests/__pycache__/
sim/tests/sim/

# gpu2d TB dump outputs
gpu2d_frame_fb.txt
gpu2d_timed_fb.txt
gpu2d_dbg_line.txt
simout/

# tb_top_frame DUMP_STATE=1 raw state dumps (VRAM A..D, palette, OAM, GPU regs)
rtl_state_banks.hex
rtl_state_pal.hex
rtl_state_oam.hex
rtl_state_gpu_regs.hex

# tb_top_frame framebuffer dumps: same class as the gpu2d ones above, but these
# were tracked as empty placeholders and so kept showing up as a 147k-line diff
# every time a frame sim ran. Regenerated by sim/run_top_frame.sh.
top_frame_fb.txt
top_frame_fb_b.txt

# retail BIOS/firmware images (copyrighted - generated locally by
# sim/tests/make_retail_bios.sh from user-supplied dumps, never commit)
sim/tests/bios7_retail.hex
sim/tests/bios9_retail.hex
sim/tests/firmware_retail.hex

# game ROM conversions (copyrighted - generate locally from your own dumps)
sim/tests/kirby_*.hex
# NITRO Tester (Nitro EVA) self-checker cart, via sim/tests/make_test_cart.sh
sim/tests/ntr_eva*.hex

# session debug logs
pipe_debug.log
repro_trace.log

# build artifact directories (reports + RBFs, regenerated by remote-build.sh)
build/artifacts*/
# per-configuration Quartus fit logs from build/ablation-matrix.sh, ~350 KB each.
# The measurements worth keeping get written up in CLAUDE.md or docs/; the logs
# themselves are regenerable output.
build/abl-*.log
sim/nvc_work_pre/
# ARM9/ARM7 retired-instruction traces: regenerated by every sim run,
# tens of MB each - outputs, not sources
isl9.txt
isl7.txt
cpi_trace9.txt
cpi_trace7.txt
isl_trace9.txt
isl_trace7.txt
occ9.txt
occ7.txt
snap9.txt
snap7.txt
bq9.txt
bq7.txt
io9.txt
io7.txt
ts9.txt
ts7.txt
hs7.txt
fix7.txt

# nvc working directories: one per WORK= value, ~1.3 MB each and one is created
# by every parallel sim pod. sim/nvc_work/ and _pre were listed individually,
# which stopped covering anything once runs started using distinct WORK= names.
sim/nvc_work_*/

# generated trace-bisect reference (from a copyrighted cart dump)
sim/tests/ntr_eva_mds_blocks.md5

# BlocksDS ROM build trees under examples/: a 435 KB .elf and a 5,000-line .map
# per ROM, regenerated by `make`. The .nds itself IS tracked, matching
# sim/tests/dmaprio - it lets someone run the ROM without a toolchain.
examples/*/build/

# nvc working dirs created when a runner is invoked from the repo root rather
# than from sim/ - the existing rule only covers sim/nvc_work_*/
nvc_work_*/

# nvc's default library dir name, created by a run invoked from the repo root
/work/

# melonds_tracer build trees: build/ is listed individually, the native and
# armhf variants use distinct names (build-native/, build-armhf/)
sim/melonds_tracer/build-*/

# melonDS harness output: tracer/gxbench session logs and the bench scene
# savestate (generated from a copyrighted ROM, same class as the kirby_*.hex
# rule above)
/melonds_trace.log
/scene.mln
