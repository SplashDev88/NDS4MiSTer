set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# Quartus 17's parallel RTL helper can deadlock under the Apple/Rosetta build
# host.  One mapper worker is deterministic and avoids producing a silently
# stale RBF; fitter effort and the synthesized hardware are unchanged.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE AREA"
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name SYNTH_TIMING_DRIVEN_SYNTHESIS OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF
set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 2.0
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

# The FPGA console sound engine drives the normal MiSTer audio cone. Keep the
# unrelated HPS ALSA reader and optional filter disabled.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
set_global_assignment -name VERILOG_MACRO "NDS_NO_AUDIO_FILTER=1"

# Use the standard scaled HDMI path because the native NDS raster is not a
# display-compatible HDMI mode. Keep analog/direct-video presentation out of
# the first alpha while retaining the OSD and controller-driven ROM picker.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_SHADOWMASK=1"
# Keep the compact scaler-only shell and its standard MiSTer scaler/OSD path.
# Like MiSTer's HDMI-only topology, the dedicated sys_top branch wires the
# selected HDMI PLL clock directly to the transmitter because direct video is
# fixed off. This removes an unused clock selector from the timing-critical
# HDMI domain. Sound remains on.
set_global_assignment -name VERILOG_MACRO "NDS_HDMI_SCALER_ONLY=1"
set_global_assignment -name VERILOG_MACRO "NDS_DISABLE_HDMI_LOW_LATENCY=1"

# Composite/S-video and adaptive/downscale filters are not first-alpha
# requirements.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"
set_global_assignment -name VERILOG_MACRO "NDS_FORCE_NEAREST=1"
set_global_assignment -name VERILOG_MACRO "NDS_FORCE_INTEGER_SCALE=1"
set_global_assignment -name VERILOG_MACRO "NDS_HYBRID_3D=1"
set_global_assignment -name VERILOG_MACRO "NDS_SEAM_DIAGNOSTIC=1"

# Native-cadence 134.055928/67.027964/33.513982 MHz Nitro clock family. The
# whole family moves together to preserve the exact 4:2:1 phase relationship.
# HDMI remains on its independent shell clock.
set_global_assignment -name VERILOG_MACRO "NDS_CLKMEM_4X=1"

# Run-time and legacy framebuffer telemetry are both absent from the product.
# Frame-rate validation uses the external read-only DDR sampler.
source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# The release is globally area-optimized so the 98% design remains routable.
# The two small, measured 148.5 MHz display blocks are the exception: give
# synthesis permission to favor their HDMI timing without bloating the console
# and sound logic.
set_instance_assignment -name OPTIMIZATION_TECHNIQUE SPEED -to hdmi_osd
set_instance_assignment -name OPTIMIZATION_TECHNIQUE SPEED -to ascal

# The alpha prioritizes a routable RBF over final timing closure. Use three
# spare global networks for the measured high-fanout reset controls.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "*|nds_nitro_console_top:inds|resetCpu"
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to {*|nds_nitro_console_island:island|console_reset_sync_1x[1]}
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to {*|nds_nitro_console_island:island|console_reset_sync_ddr[1]}

